<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plugin para Civil 3D 2027 (.NET 10). Requiere Visual Studio 2026. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <AssemblyName>VisibilidadParada</AssemblyName>
    <RootNamespace>VisibilidadParada</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Ajuste esta ruta si Civil 3D está instalado en otra carpeta -->
  <PropertyGroup>
    <C3DPath>C:\Program Files\Autodesk\AutoCAD 2027</C3DPath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <!-- Referencias de AutoCAD / Civil 3D: Copy Local = False (Private=false) -->
  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(C3DPath)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(C3DPath)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(C3DPath)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AecBaseMgd">
      <HintPath>$(C3DPath)\ACA\AecBaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AeccDbMgd">
      <HintPath>$(C3DPath)\C3D\AeccDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
